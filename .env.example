# RaizServer base URL. Server-only: the browser talks to /api/raiz, which
# forwards to this URL with the session token. (NEXT_PUBLIC_BASE_URL is still
# read as a fallback so existing deployments keep working.)
RAIZ_API_URL=https://stageapi.raizserver.com

# Public URL of this app (used in invoice payment links).
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# development | test | sandbox | staging | preview | production. Controls which
# API-key scopes developers may request; unset or unknown counts as production.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

NEXT_PUBLIC_STRIPE_PUBLISH_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API=

# Optional: extra hosts (comma separated) payment proofs may be downloaded from.
# S3 hosts (*.s3.*.amazonaws.com) are always allowed.
PAYMENT_PROOF_ALLOWED_HOSTS=
